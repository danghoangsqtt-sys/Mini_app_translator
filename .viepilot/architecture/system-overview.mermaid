flowchart LR
    subgraph PhoneA["Phone A — local speaker"]
        MicA[Microphone] --> SpeechA[Android SpeechRecognizer\non-device preferred]
        SpeechA --> ControllerA[Conversation controller\nbounded turn + generation gate]
        ControllerA --> MlKitA[ML Kit Translation\ndownloaded model]
        MlKitA --> BTA[ConversationBluetoothCommunicator]
    end

    BTA <-->|translated text over Bluetooth| BTB[ConversationBluetoothCommunicator]

    subgraph PhoneB["Phone B — peer"]
        BTB --> MlKitB[ML Kit Translation\ndownloaded model]
        MlKitB --> TTSB[Android TextToSpeech]
    end

    ModelService[Google model infrastructure] -.download/update models.-> MlKitA
    ModelService -.download/update models.-> MlKitB
    SystemSpeech[Selected Android system recognizer\nmay use network] -.capability-dependent.-> SpeechA

    LegacyKey[Optional legacy Cloud credential\nencrypted on device] -.migration storage only\nno automatic runtime selection.-> Legacy[Isolated legacy adapters]
